# Copy this file to a local `.env` in the repo root:
#   cp .env.example .env
#
# Docker Compose reads these values automatically from that `.env` file, so you
# only need to change the ones that differ from the defaults below. No secrets
# here: every value is a non-secret placeholder that is safe to commit.

# ----- Database service (db) ------------------------------------------------
# Credentials and database name used by the postgres:16 container, and baked
# into the API service's DATABASE_URL.
POSTGRES_USER=tesla
POSTGRES_PASSWORD=tesla_dev_only
POSTGRES_DB=dhaka_tesla_pool

# ----- Backend API service (api) --------------------------------------------
# Connection string the API uses. Compose builds it from the POSTGRES_* values
# against the `db` service hostname; this entry documents what it looks like.
DATABASE_URL=postgresql://tesla:tesla_dev_only@db:5432/dhaka_tesla_pool?schema=public
# Secret used to sign JWT tokens. Rotate this for any real deployment.
JWT_SECRET=change-me-in-production
# JWT lifetime, e.g. "7d", "1h", "30m".
JWT_EXPIRES_IN=7d
# Port the API listens on inside the api container.
PORT=4000

# ----- Frontend service (web) ------------------------------------------------
# Base URL the Next.js BFF proxy uses to reach the API. Inside the compose
# network the API is reachable at http://api:4000 (its service name), so the
# same value works at build time and at runtime. Do NOT point this at
# localhost when running the containers.
NEXT_PUBLIC_API_URL=http://api:4000
# Host port the web app is published on.
WEB_PORT=3000