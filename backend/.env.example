# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/dhaka_tesla_pool?schema=public"

# Separate database used by the automated test suite (required to run tests)
TEST_DATABASE_URL="postgresql://user:password@localhost:5432/dhaka_tesla_pool_test?schema=public"

# Secret used to sign JWT tokens
JWT_SECRET="change-me"

# JWT lifetime, e.g. "7d", "1h", "30m"
JWT_EXPIRES_IN="7d"

# Port the API server listens on
PORT=4000